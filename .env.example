# Copie ce fichier en .env.local (ignoré par Git) et remplis les valeurs.
# Les variables VITE_* finissent dans le JavaScript envoyé au navigateur :
# n'y mets JAMAIS de clé secrète. La clé publishable/anon est faite pour être publique,
# c'est la RLS qui protège les données.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → clé "publishable" (sb_publishable_...) ou l'ancienne clé "anon"
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Secrets côté serveur : PAS dans ce fichier ---
# Le jeton TMDB ne va que dans les secrets des Edge Functions :
#   npx supabase secrets set TMDB_READ_TOKEN=eyJ...
